@echo off
setlocal

echo ==============================================
echo RESTAURANDO AS EXTENSOES DOS ARQUIVOS
echo ==============================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
"$root = $env:CD; Get-ChildItem -LiteralPath $root -Recurse -File -Filter '*.txt' | Where-Object { $_.BaseName -match '\.' } | ForEach-Object { $novo = Join-Path $_.DirectoryName $_.BaseName; if (-not (Test-Path -LiteralPath $novo)) { Write-Host ('Restaurando: ' + $_.FullName); Rename-Item -LiteralPath $_.FullName -NewName $_.BaseName } else { Write-Host ('IGNORADO - arquivo ja existe: ' + $novo) } }"

echo.
echo ==============================================
echo PROCESSO CONCLUIDO
echo ==============================================
pause