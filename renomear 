@echo off
setlocal EnableExtensions

set "renomeados=0"
set "ignorados=0"

echo Removendo o .txt adicionado aos arquivos...
echo.

for /r %%F in (*.txt) do (
    for %%G in ("%%~nF") do (
        if not "%%~xG"=="" (
            if exist "%%~dpF%%~nF" (
                echo [IGNORADO] Ja existe um arquivo chamado:
                echo "%%~dpF%%~nF"
                echo.
                set /a ignorados+=1
            ) else (
                echo Renomeando:
                echo "%%~fF"
                echo para:
                echo "%%~dpF%%~nF"
                echo.

                ren "%%~fF" "%%~nF"
                set /a renomeados+=1
            )
        )
    )
)

echo ----------------------------------------
echo Processo concluido.
echo Arquivos renomeados: %renomeados%
echo Arquivos ignorados: %ignorados%
echo ----------------------------------------
pause