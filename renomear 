var textoExibicao =
    _observacoes[indice].Texto;

if (_observacoes[indice].Anexos.Count > 0)
{
    var nomes =
        new List<string>();

    foreach (var anexo in
        _observacoes[indice].Anexos)
    {
        nomes.Add(
            anexo.NomeOriginal);
    }

    textoExibicao +=
        System.Environment.NewLine +
        "Anexos: " +
        string.Join(", ", nomes);
}

linha.Controls.Add(
    new Label
    {
        Text = textoExibicao,
        AutoSize = true,
        MaximumSize =
            new System.Drawing.Size(
                550,
                0)
    });