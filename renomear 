Private Function ObterPrioridadeNome(nomePasta As String, codigo As String) As Integer
    If String.IsNullOrWhiteSpace(nomePasta) OrElse String.IsNullOrWhiteSpace(codigo) Then
        Return 9
    End If

    Dim nome As String = nomePasta.Trim()

    If Regex.IsMatch(nome, "^" & Regex.Escape(codigo) & "(?:$|[ _-])", RegexOptions.IgnoreCase) Then
        Return 0
    End If

    If Regex.IsMatch(nome, "^" & Regex.Escape(codigo) & "[A-Za-z](?:$|[ _-])", RegexOptions.IgnoreCase) Then
        Return 1
    End If

    Return 9
End Function