resultado.Sort(
    Function(a As ProjetoEncontrado, b As ProjetoEncontrado)
        Dim compCodigo As Integer = ObterPrioridadeNome(a.NomePasta, codigo).CompareTo(ObterPrioridadeNome(b.NomePasta, codigo))

        If compCodigo <> 0 Then
            Return compCodigo
        End If

        Return b.DataAlteracao.CompareTo(a.DataAlteracao)
    End Function
)