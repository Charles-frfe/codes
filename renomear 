@echo off
setlocal EnableExtensions

title Remover TXT dos arquivos

echo ============================================
echo  RESTAURANDO EXTENSOES DOS ARQUIVOS
echo ============================================
echo.
echo Pasta analisada:
echo %~dp0
echo.

set /a TOTAL=0
set /a ALTERADOS=0

for /r "%~dp0" %%F in (*.txt) do (
    set /a TOTAL+=1

    for %%G in ("%%~nF") do (
        if not "%%~xG"=="" (
            echo Encontrado:
            echo %%~fF
            echo.
            
            ren "%%~fF" "%%~nF"

            if errorlevel 1 (
                echo [ERRO] Nao foi possivel renomear.
            ) else (
                echo [OK] Restaurado para: %%~nF
                set /a ALTERADOS+=1
            )

            echo --------------------------------------------
        )
    )
)

echo.
echo ============================================
echo PROCESSO FINALIZADO
echo ============================================
echo Arquivos .txt encontrados: %TOTAL%
echo Arquivos restaurados: %ALTERADOS%
echo.
echo Pressione qualquer tecla para fechar.
pause >nul