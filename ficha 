Private Function IdentificarMatriz(caminho As String) As String

    Try

        Dim pastaAtual As DirectoryInfo = New FileInfo(caminho).Directory

        While pastaAtual IsNot Nothing

            If pastaAtual.Name.Equals(
                "Lav",
                System.StringComparison.OrdinalIgnoreCase
            ) Then

                If pastaAtual.Parent IsNot Nothing Then
                    Return pastaAtual.Parent.Name
                End If

            End If

            pastaAtual = pastaAtual.Parent

        End While

    Catch
    End Try

    Return "Não identificado"

End Function

Private Function IdentificarTextura(caminho As String) As String

    Try

        Dim arquivo As New FileInfo(caminho)
        Dim pastaAtual As DirectoryInfo = arquivo.Directory

        If pastaAtual Is Nothing Then
            Return Path.GetFileNameWithoutExtension(caminho)
        End If

        ' Exemplo:
        ' Grava\Lav\gls_012\lav_012_OR_LaserDesign_Report.rtf
        If pastaAtual.Parent IsNot Nothing AndAlso
           pastaAtual.Parent.Name.Equals(
               "Lav",
               System.StringComparison.OrdinalIgnoreCase
           ) Then

            Return pastaAtual.Name

        End If

        ' Exemplo:
        ' Tampa\Lav\lav_012_OR_LaserDesign_Report.rtf
        If pastaAtual.Name.Equals(
            "Lav",
            System.StringComparison.OrdinalIgnoreCase
        ) Then

            Dim nomeArquivo As String =
                Path.GetFileNameWithoutExtension(caminho)

            nomeArquivo =
                nomeArquivo.Replace("_OR_LaserDesign_Report", "")

            nomeArquivo =
                nomeArquivo.Replace("_LaserDesign_Report", "")

            Return nomeArquivo

        End If

    Catch
    End Try

    Return Path.GetFileNameWithoutExtension(caminho)

End Function