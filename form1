Private Sub btnCalcular_Click(sender As Object, e As EventArgs) Handles btnCalcular.Click

    If _texturas.Count = 0 Then
        MessageBox.Show(
            "Busque um modelo antes de calcular.",
            "Estimador",
            MessageBoxButtons.OK,
            MessageBoxIcon.Information
        )
        Return
    End If

    lstResultado.Items.Clear()

    Dim totalPiloto As TimeSpan = TimeSpan.Zero
    Dim totalEstimado As TimeSpan = TimeSpan.Zero

    Dim gruposMatriz = _texturas _
        .GroupBy(Function(t) t.TipoMatriz) _
        .OrderBy(Function(g) g.Key)

    For Each grupo In gruposMatriz

        lstResultado.Items.Add("===================================")
        lstResultado.Items.Add("MATRIZ: " & grupo.Key.ToUpperInvariant())
        lstResultado.Items.Add("-----------------------------------")

        Dim totalPilotoMatriz As TimeSpan = TimeSpan.Zero
        Dim totalEstimadoMatriz As TimeSpan = TimeSpan.Zero

        For Each textura In grupo

            Dim resultado = _calculadora.Calcular(
                textura,
                CInt(nudParesPiloto.Value),
                CInt(nudParesEscala.Value),
                cboMaquinaEscala.Text
            )

            totalPilotoMatriz += resultado.TempoPiloto
            totalEstimadoMatriz += resultado.TempoTotalEstimado

            totalPiloto += resultado.TempoPiloto
            totalEstimado += resultado.TempoTotalEstimado

            lstResultado.Items.Add(
                String.Format(
                    "{0} | Piloto: {1} | Estimado: {2}",
                    textura.NomeTextura,
                    FormatarTempo(resultado.TempoPiloto),
                    FormatarTempo(resultado.TempoTotalEstimado)
                )
            )

        Next

        lstResultado.Items.Add("-----------------------------------")

        lstResultado.Items.Add(
            "TOTAL " &
            grupo.Key.ToUpperInvariant() &
            ": " &
            FormatarTempo(totalEstimadoMatriz)
        )

        lstResultado.Items.Add("")

    Next

    lblTempoPiloto.Text = FormatarTempo(totalPiloto)
    lblTempoEstimado.Text = FormatarTempo(totalEstimado)

    lblStatus.Text =
        String.Format(
            "{0} matriz(es) e {1} textura(s) calculadas.",
            gruposMatriz.Count(),
            _texturas.Count
        )

End Sub